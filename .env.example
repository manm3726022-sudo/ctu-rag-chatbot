# .env.example - sao chép thành .env rồi điền giá trị thật:
#   cp .env.example .env
# KHÔNG commit file .env. Chỉ commit file .env.example này.

# --- GroqCloud Free API (chỉ dùng ở backend) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_S=30
GROQ_MAX_OUTPUT_TOKENS=800
# Ngân sách token mỗi phút, đặt thấp hơn hạn mức 8.000 TPM để chừa biên an toàn
GROQ_TPM_BUDGET=6000

# --- Qdrant (chạy bằng Docker Compose) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ctu_knowledge

# --- Mô hình chạy local ---
EMBED_BACKEND=bge-m3
RERANK_BACKEND=bge
# Khi dùng PhoRanker, đặt CHUNKING_MODE=phoranker và ingest vào collection mới.
CHUNKING_MODE=legacy
# Tùy chọn: EMBED_BACKEND=mgte (collection mới) và RERANK_BACKEND=phoranker.
# Chỉ đặt EMBED_MODEL / RERANK_MODEL nếu dùng đường dẫn local hoặc model khác.
# EVIDENCE_TOKENIZER_MODEL=BAAI/bge-m3  # giữ cách đếm token khi A/B
# true nếu có GPU; để false khi chạy CPU
USE_FP16=false

# --- Truy xuất và bằng chứng ---
RETRIEVE_PREFETCH=20
RETRIEVE_LIMIT=20
EVIDENCE_MAX_CHUNKS=6
# Mỗi câu hỏi tốn ~ (system prompt ~400 + evidence + 800 đầu ra) token. Với GROQ_TPM_BUDGET=6000 và
# EVIDENCE_MAX_TOKENS=3000 chỉ vừa ~1 câu/phút; hạ xuống ~1800 nếu cần 2 câu/phút (đo thật bằng T19 trước).
EVIDENCE_MAX_TOKENS=3000
# Để trống đến khi hiệu chỉnh trên tập validation (runbook §13.4). Lưu ý: bộ gold chỉ có 2 câu ngoài kho
# nên chưa đủ mẫu để hiệu chỉnh; xem docs/design.md (D8).
RERANK_ABSTAIN_THRESHOLD=

# --- Truy xuất của TV3 ---
# true  = chỉ dùng đoạn đã duyệt (review_status=checked) làm bằng chứng  (chế độ demo/nghiệm thu)
# false = gồm cả đoạn pending (thử nghiệm trước khi TV1/TV2 duyệt xong 170 đoạn)
RETRIEVE_REQUIRE_CHECKED=true
# Số đoạn tối đa được "ghim" khi câu hỏi nêu đích danh "Điều N" hoặc "Phụ lục V.b"
RETRIEVE_MAX_PINNED=8
# Lượt chọn evidence: lấy đoạn tốt nhất của mỗi văn bản nếu điểm >= tỷ lệ này * điểm cao nhất
EVIDENCE_DIVERSITY_RATIO=0.5
EMBED_QUERY_MAX_LENGTH=512
RERANK_MAX_LENGTH=1024
RERANK_BATCH_SIZE=8
# Để trống = dùng docs/corpus/documents.json và data/review/approved_chunks.csv
MANIFEST_PATH=
APPROVED_CHUNKS_PATH=

# --- Bộ truy xuất: mock (dữ liệu giả, TV4 tự chạy được) | real (retriever của TV3) ---
RETRIEVER=mock

# --- Giao diện gọi backend ---
API_URL=http://localhost:8000
