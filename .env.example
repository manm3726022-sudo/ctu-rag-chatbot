# .env.example - sao chép thành .env rồi điền giá trị thật:
#   cp .env.example .env
# KHÔNG commit file .env. Chỉ commit file .env.example này.

# --- GroqCloud Free API (chỉ dùng ở backend) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_S=30
GROQ_MAX_OUTPUT_TOKENS=800
# Ngân sách token mỗi phút, đặt thấp hơn hạn mức 8.000 TPM để chừa biên an toàn
GROQ_TPM_BUDGET=6000

# --- Qdrant (chạy bằng Docker Compose) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ctu_knowledge

# --- Mô hình chạy local ---
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# true nếu có GPU; để false khi chạy CPU
USE_FP16=false

# --- Truy xuất và bằng chứng ---
RETRIEVE_PREFETCH=20
RETRIEVE_LIMIT=20
EVIDENCE_MAX_CHUNKS=6
EVIDENCE_MAX_TOKENS=3000
# Để trống đến khi hiệu chỉnh trên tập validation (runbook §13.4)
RERANK_ABSTAIN_THRESHOLD=

# --- Bộ truy xuất: mock (dữ liệu giả, TV4 tự chạy được) | real (retriever của TV3) ---
RETRIEVER=mock

# --- Giao diện gọi backend ---
API_URL=http://localhost:8000
